# Copy values into the environment of the backend process; Spring does NOT auto-load this file.
ARK_API_KEY=
# Copy an available model ID or inference endpoint ID from your Ark console.
ARK_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Optional speech recognition: enable volc.bigasr.auc_turbo in the speech console.
# Separate from Ark chat credentials. Prefer the new-console API key.
VOLC_SPEECH_API_KEY=
# Legacy console only: use the pair below instead of VOLC_SPEECH_API_KEY.
VOLC_SPEECH_APP_ID=
VOLC_SPEECH_ACCESS_TOKEN=
VOLC_SPEECH_ENDPOINT=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
VOLC_SPEECH_REQUEST_TIMEOUT_MS=30000
